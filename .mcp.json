{
  "mcpServers": {
    "morai-pipeline": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "servers.pipeline.server"],
      "env": {
        "MORAI_MEMORY_PATH": "${user_config.MORAI_GLOBAL_PATH}/memory",
        "MORAI_PIPELINE_PATH": "${workspaceFolder}/.morai/pipeline",
        "MORAI_BUDGET_TOKENS": "200000"
      }
    },
    "morai-events": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "servers.events.server"],
      "env": {
        "MORAI_MEMORY_PATH": "${user_config.MORAI_GLOBAL_PATH}/memory"
      }
    },
    "morai-memory": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "servers.memory.server"],
      "env": {
        "MORAI_MEMORY_PATH": "${user_config.MORAI_GLOBAL_PATH}/memory",
        "MORAI_TASKS_PATH": "${user_config.MORAI_GLOBAL_PATH}/tasks",
        "MORAI_DESIGN_REPO": "${user_config.MORAI_DESIGN_REPO}"
      }
    },
    "morai-rag": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "servers.rag.server"],
      "env": {
        "CHROMA_PATH": "${workspaceFolder}/.morai/rag"
      }
    },
    "morai-file": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "servers.file.server"],
      "env": {
        "WORKSPACE_ROOT": "${workspaceFolder}"
      }
    },
    "morai-git": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "servers.git.server"],
      "env": {
        "WORKSPACE_ROOT": "${workspaceFolder}"
      }
    },
    "morai-jira": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "servers.jira.server"],
      "env": {
        "JIRA_URL": "${user_config.JIRA_URL}",
        "JIRA_EMAIL": "${user_config.JIRA_EMAIL}",
        "JIRA_TOKEN": "${user_config.JIRA_TOKEN}"
      }
    },
    "morai-confluence": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "servers.confluence.server"],
      "env": {
        "CONFLUENCE_URL": "${user_config.CONFLUENCE_URL}",
        "CONFLUENCE_EMAIL": "${user_config.CONFLUENCE_EMAIL}",
        "CONFLUENCE_TOKEN": "${user_config.CONFLUENCE_TOKEN}"
      }
    },
    "morai-slack": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "servers.morai.server"],
      "env": {
        "SLACK_BOT_TOKEN": "${user_config.SLACK_BOT_TOKEN}",
        "SLACK_APP_TOKEN": "${user_config.SLACK_APP_TOKEN}"
      }
    },
    "morai-test": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "servers.test_runner.server"],
      "env": {
        "WORKSPACE_ROOT": "${workspaceFolder}"
      }
    }
  }
}
