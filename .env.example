# Anthropic
ANTHROPIC_API_KEY=

# Workspace (used by morai-file and morai-git servers) — REQUIRED, must be absolute path
WORKSPACE_ROOT=/absolute/path/to/your/project

# Memory (used by morai-memory server)
MORAI_MEMORY_PATH=.morai/memory

# Design repo — local path to {project-name}-design repo clone
# Set this to enable team knowledge sharing after each ticket
# e.g. /home/user/projects/myapp-design
MORAI_DESIGN_REPO=

# RAG (used by morai-rag server)
CHROMA_PATH=.morai/rag

# Jira (used by morai-jira server)
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_TOKEN=

# Confluence (used by morai-confluence server)
CONFLUENCE_URL=https://yourorg.atlassian.net/wiki
CONFLUENCE_EMAIL=your@email.com
CONFLUENCE_TOKEN=

# GitHub (used by morai-git for PR review — github.com repos)
GITHUB_TOKEN=

# Bitbucket (used by morai-git for PR review)
BITBUCKET_USERNAME=
BITBUCKET_TOKEN=
# Bitbucket Server only — leave empty for Bitbucket Cloud
# Auto-detected from git remote if host matches this URL
BITBUCKET_BASE_URL=https://git.mycompany.com

# Slack (used by morai-slack server)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL=

# Telegram (used by morai-telegram server)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=
