# Anthropic
ANTHROPIC_API_KEY=

# Workspace (used by morai-file and morai-git servers) — REQUIRED, must be absolute path
WORKSPACE_ROOT=/absolute/path/to/your/project

# Memory (used by morai-memory server)
MORAI_MEMORY_PATH=.morai/memory

# RAG (used by morai-rag server)
CHROMA_PATH=.morai/rag

# Jira (used by morai-jira server)
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_TOKEN=

# Confluence (used by morai-confluence server)
CONFLUENCE_URL=https://yourorg.atlassian.net/wiki
CONFLUENCE_EMAIL=your@email.com
CONFLUENCE_TOKEN=

# Slack (used by morai-slack server)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
